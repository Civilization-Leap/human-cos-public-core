# Copy to `.env` and fill with real values. Never commit `.env`.
# S0 only defines the variable names; no defaults/secrets here.

# Runtime mode: development | test | production
HUMAN_COS_ENV=development

# PostgreSQL (used from S1 onward)
HUMAN_COS_DATABASE_URL=postgresql://human_cos:human_cos@localhost:5432/human_cos

# API listen (used from S2+)
HUMAN_COS_HTTP_HOST=0.0.0.0
HUMAN_COS_HTTP_PORT=8000
